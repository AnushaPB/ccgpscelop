rule algatr_env:
    """
    Set up env to run algatr
    """
    input: 
        vcf = "../../data/ccgp_data/58-Sceloporus_annotated_pruned_0.6.vcf.gz",
    output:
        "outputs/{prefix}_env_created.txt"
    conda:
        "envs/algatr.yml"
    log:
        "logs/algatr/{prefix}_env_creation.txt"
    script:
        "algatr/setup_algatr_env.R"

rule algatr_separate_vcf_ld06:
    input:
        fai = "../../data/genome/{refGenome}.fna.fai",
        vcf = "../../data/ccgp_data/{prefix}_annotated_pruned_0.6.vcf.gz",
        csi = "../../data/ccgp_data/{prefix}_annotated_pruned_0.6.vcf.gz.csi",
    output:
        scaf = "../gea/outputs/RDA_results/subsets/{prefix}_{scaff}_annotated_pruned_0.6.vcf.gz"
    conda:
        "envs/bcftools.yml"
    log:
        "logs/algatr/subsets/{prefix}_{scaff}_pruned.scaff.txt"
    shell:
         """
         bcftools view -r {wildcards.scaff} {input.vcf} -Oz -o {output.scaf}
         """

rule algatr_RDA:
    """
    call algatr RDA 
    """
    input:
        env = "outputs/{prefix}_env_created.txt",
        vcf = "../gea/outputs/RDA_results/subsets/{prefix}_{scaff}_annotated_pruned_0.6.vcf.gz",
        # eigenvec = "outputs/{prefix}.eigenvec",
    params:
        species = config['final_prefix'],
        output_path = "../gea/outputs/RDA_results/{scaff}/",
        rmislands = "true",
        impute = "simple",
        correctGEO = "false",
        correctPC = "false", # true or false
        pc_path = "../../data/ccgp_data/{prefix}.eigenvec",
        nPC = 1, # number of pcs (ignored if data type is admixture)
        pc_data_type = "pca", # options are "pca" or "admixture"
        species_ks = 1, # number of ks if using admixture for partial RDA (ignored if data type is PCA)
        model = "full", #TECHNICALLY SNAKEMAKE WOULDNT WORK IF I CHANGE THIS
        sig = 0.01, # only for outlier_method = "p"
        z = 3, # only for outlier_method = "z"
        Pin = 0.05,
        R2permutations = 1000,
        R2scope = "true",
        p_adj = "fdr", # only if outlier_method = "p"
        save_impute = "true",
        intervals = "true",
        scaff = "{scaff}",
        env_var_type = "bio1ndvi",
        shape_path = "/../data/CA_State_2024_noChannelIslands/CA_State_2024.shp" # only used if rmislands=TRUE
    resources:
        mem_mb = lambda wildcards, attempt: attempt * 2000
    log:
        "logs/subsets/{prefix}_{scaff}.RDA.txt"
    benchmark:
        "outputs/{prefix}_{scaff}.RDA.benchmark.txt"
    output: 
        zscore_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_RDA_outliers_full_Zscores.csv",
        rdadapt_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_RDA_outliers_full_rdadapt.csv",
        cortest_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_RDA_cortest_full.csv",
        imputed_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_imputed_simple.txt",
        peakram_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_RDA_peakRAM.csv",
        colsum_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_colsum.csv",
        ybar_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_Ybar.csv",
        v_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_v.csv",
        u_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_u.csv",
        wa_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_wa.csv",
        qr_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_qr.csv",
        eig_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_eig.csv",
        biplot_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_biplot.csv",
        qraux_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_qraux.csv",
        envcentre_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_envcentre.csv",
        chi_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_totchi.csv",
        scalload_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_scaledloadings.csv",
        unscalload_output = "../gea/outputs/RDA_results/{scaff}/{prefix}_unscaledloadings.csv"
    conda:
        "envs/algatr.yml"
    script:
        "algatr/RDA.R"

def gather_rda(wildcards):
